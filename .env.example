# API Server Configuration
PORT=4000
NODE_ENV=development

# Database (PostgreSQL via Supabase)
DATABASE_URL=postgresql://postgres:your-db-password@db.your-supabase-ref.supabase.co:5432/postgres

# Supabase Auth & Storage
SUPABASE_URL=https://your-supabase-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# LLM Provider Configuration (Server-side ONLY)
LLM_PROVIDER=openai
LLM_API_KEY=your-llm-api-key
LLM_MODEL=gpt-4o-mini

# Mobile App Configuration (Exposed to Expo client)
EXPO_PUBLIC_API_URL=http://localhost:4000/api
EXPO_PUBLIC_SUPABASE_URL=https://your-supabase-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
